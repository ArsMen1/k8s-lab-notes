# Исключаем локальное состояние рабочего пространства (постоянно меняется)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/workspace*.json

# Исключаем кэш и индексы
.obsidian/cache/
.obsidian/graph.json
.obsidian/copilot-index*.json

# Кэш плагина Git (чтобы не коммитить каждый auto-save)
.obsidian/plugins/*/data.json